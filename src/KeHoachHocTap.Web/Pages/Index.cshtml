                                <button type="button" class="btn btn-sm btn-light border py-0 px-1 small" onclick="$('#closingActivityName').val('Lễ bế giảng & Trao bằng tốt nghiệp'); $('input[name=Periods]', '#addClosingActivityModal').val('5'); $('input[name=Sessions]', '#addClosingActivityModal').val('1');">Lễ bế giảng</button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Từ ngày</label>
                                <input type="date" name="FromDate" class="desktop-input w-100" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Đến ngày</label>
                                <input type="date" name="ToDate" class="desktop-input w-100" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số buổi</label>
                                <input type="number" name="Sessions" min="1" max="1000" class="desktop-input w-100" placeholder="Ví dụ: 3" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số tiết</label>
                                <input type="number" name="Periods" min="1" max="10000" class="desktop-input w-100" placeholder="Ví dụ: 15" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ghi chú</label>
                            <input type="text" name="Note" maxlength="500" class="desktop-input w-100" placeholder="Ghi chú thêm..." />
                        </div>
                    </div>
                    <div class="modal-footer p-2 bg-light">
                        <button type="button" class="toolbar-btn" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="toolbar-btn btn-success px-3">Lưu hoạt động</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Sửa hoạt động (Chỉ Admin) -->
    <div class="modal fade" id="editActivityModal" tabindex="-1" aria-labelledby="editActivityModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdateActivity">
                    <input type="hidden" id="editActivityId" name="Id" />
                    <input type="hidden" id="editActivityType" name="Type" />
                    <div class="modal-header desktop-titlebar py-2 text-white">
                        <h6 class="modal-title fw-bold" id="editActivityModalLabel">CHỈNH SỬA HOẠT ĐỘNG</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-3">
                        <div class="mb-3" id="editActivityAfterSubjectGroup">
                            <label class="form-label fw-bold">Môn học đứng trước</label>
                            <select id="editActivityAfterSubjectId" name="AfterSubjectId" class="desktop-input w-100">
                                <option value="">-- Không chọn --</option>
                                @foreach (var item in Model.Items)
                                {
                                    <option value="@item.Subject.Id">#@item.Number - @item.Subject.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên hoạt động <span class="text-danger">*</span></label>
                            <input type="text" id="editActivityName" name="Name" class="desktop-input w-100" required maxlength="200" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Từ ngày</label>
                                <input type="date" id="editActivityFromDate" name="FromDate" class="desktop-input w-100" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Đến ngày</label>
                                <input type="date" id="editActivityToDate" name="ToDate" class="desktop-input w-100" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số buổi</label>
                                <input type="number" id="editActivitySessions" name="Sessions" min="1" class="desktop-input w-100" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Số tiết</label>
                                <input type="number" id="editActivityPeriods" name="Periods" min="1" class="desktop-input w-100" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ghi chú</label>
                            <input type="text" id="editActivityNote" name="Note" maxlength="500" class="desktop-input w-100" />
                        </div>
                    </div>
                    <div class="modal-footer p-2 bg-light">
                        <button type="button" class="toolbar-btn" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="toolbar-btn btn-primary px-3">Cập nhật thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Xác nhận xóa hoạt động (Chỉ Admin) -->
    <div class="modal fade" id="deleteActivityModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <form method="post" asp-page-handler="DeleteActivity">
                    <input type="hidden" id="deleteActivityId" name="id" />
                    <div class="modal-header bg-danger text-white py-2">
                        <h6 class="modal-title fw-bold">XÁC NHẬN XÓA</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-3 text-center">
                        <p class="mb-1">Bạn có chắc chắn muốn xóa hoạt động:</p>
                        <p class="fw-bold text-danger mb-2" id="deleteActivityNameDisplay"></p>
                    </div>
                    <div class="modal-footer p-2 bg-light justify-content-center">
                        <button type="button" class="toolbar-btn" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="toolbar-btn btn-danger px-3">Đồng ý Xóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#addExamMode').on('change', function () {
                if ($(this).val() === 'Custom') {
                    $('#addCustomExamSlotGroup').show();
                } else {
                    $('#addCustomExamSlotGroup').hide();
                }
            });

            $('#editExamMode').on('change', function () {
                if ($(this).val() === 'Custom') {
                    $('#editCustomExamSlotGroup').show();
                } else {
                    $('#editCustomExamSlotGroup').hide();
                }
            });

            $('.btn-edit').on('click', function () {
                var btn = $(this);
                $('#editSubjectId').val(btn.data('id'));
                $('#editSubjectName').val(btn.data('name'));
                $('#editSubjectPeriods').val(btn.data('periods'));
                $('#editSubjectGrade').val(btn.data('grade'));
                $('#editSubjectReserve').val(btn.data('reserve'));
                $('#editSubjectNote').val(btn.data('note'));

                var examMode = btn.data('exammode') || 'Immediately';
                $('#editExamMode').val(examMode);
                $('#editCustomExamSlot').val(btn.data('customexamslot') || '');
                if (examMode === 'Custom') {
                    $('#editCustomExamSlotGroup').show();
                } else {
                    $('#editCustomExamSlotGroup').hide();
                }

                var editModal = new bootstrap.Modal(document.getElementById('editSubjectModal'));
                editModal.show();
            });

            $('.btn-delete').on('click', function () {
                var btn = $(this);
                $('#deleteSubjectId').val(btn.data('id'));
                $('#deleteSubjectName').text(btn.data('name'));

                var deleteModal = new bootstrap.Modal(document.getElementById('deleteSubjectModal'));
                deleteModal.show();
            });

            $('.btn-edit-activity').on('click', function () {
                var btn = $(this);
                $('#editActivityId').val(btn.data('id'));
                var type = btn.data('type');
                $('#editActivityType').val(type);
                $('#editActivityName').val(btn.data('name'));
                $('#editActivityAfterSubjectId').val(btn.data('after') || '');
                $('#editActivityFromDate').val(btn.data('from') || '');
                $('#editActivityToDate').val(btn.data('to') || '');
                $('#editActivitySessions').val(btn.data('sessions') || '');
                $('#editActivityPeriods').val(btn.data('periods') || '');
                $('#editActivityNote').val(btn.data('note') || '');

                if (type == 0) { // Interim
                    $('#editActivityAfterSubjectGroup').show();
                } else {
                    $('#editActivityAfterSubjectGroup').hide();
                }

                var modal = new bootstrap.Modal(document.getElementById('editActivityModal'));
                modal.show();
            });

            $('.btn-delete-activity').on('click', function () {
                var btn = $(this);
                $('#deleteActivityId').val(btn.data('id'));
                $('#deleteActivityNameDisplay').text(btn.data('name'));

                var modal = new bootstrap.Modal(document.getElementById('deleteActivityModal'));
                modal.show();
            });

            // Chuyển đổi qua lại giữa Chế độ xem Thẻ & Bảng trên thiết bị di động
            $('#btnViewCards').on('click', function () {
                $('.mobile-cards-container').addClass('active-view');
                $('.desktop-datagrid-container').addClass('hidden-mobile');
                $('#btnViewCards').addClass('btn-primary');
                $('#btnViewTable').removeClass('btn-primary');
                localStorage.setItem('kehoach_view_mode', 'cards');
            });

            $('#btnViewTable').on('click', function () {
                $('.mobile-cards-container').removeClass('active-view');
                $('.desktop-datagrid-container').removeClass('hidden-mobile');
                $('#btnViewTable').addClass('btn-primary');
                $('#btnViewCards').removeClass('btn-primary');
                localStorage.setItem('kehoach_view_mode', 'table');
            });

            // Khôi phục tùy chọn xem ưa thích trước đó
            var savedMode = localStorage.getItem('kehoach_view_mode');
            if (savedMode === 'table') {
                $('#btnViewTable').trigger('click');
            }

            // =================================================================
            // Bật / Tắt hiển thị cột Điểm (Mặc định: ẨN)
            // =================================================================
            function applyGradeVisibility(show) {
                if (show) {
                    $('.col-grade').show();
                    $('#btnToggleGrades').addClass('btn-primary');
                    $('#gradeIcon').text('👁️‍🗨️');
                    $('#gradeBtnText').text('Ẩn cột điểm');
                } else {
                    $('.col-grade').hide();
                    $('#btnToggleGrades').removeClass('btn-primary');
                    $('#gradeIcon').text('👁️');
                    $('#gradeBtnText').text('Hiện cột điểm');
                }
            }

            $('#btnToggleGrades').on('click', function () {
                var current = localStorage.getItem('kehoach_show_grades') === 'true';
                var nextState = !current;
                localStorage.setItem('kehoach_show_grades', nextState ? 'true' : 'false');
                applyGradeVisibility(nextState);
            });

            // Mặc định ẩn, trừ khi người dùng đã chủ động bật trước đó
            var initialGradeShow = localStorage.getItem('kehoach_show_grades') === 'true';
            applyGradeVisibility(initialGradeShow);
        });
    </script>
}
