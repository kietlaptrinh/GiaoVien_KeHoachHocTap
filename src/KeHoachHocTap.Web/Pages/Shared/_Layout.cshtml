@inject KeHoachHocTap.Web.Services.IAdminAuthService AdminAuth
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kế hoạch học tập</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="desktop-app">
        <!-- Application Navigation Bar -->
        <header>
            <!-- Toolbar / Menubar -->
            <nav class="desktop-menubar">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Curriculum" ? "active" : "")" asp-area="" asp-page="/Curriculum">
                            <strong>Khung chương trình</strong>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" || ViewContext.RouteData.Values["page"]?.ToString() == "/Holidays" || ViewContext.RouteData.Values["page"]?.ToString() == "/Export" || ViewContext.RouteData.Values["page"]?.ToString() == "/Templates" || ViewContext.RouteData.Values["page"]?.ToString() == "/Import" ? "active" : "")" asp-area="" asp-page="/Index">
                            <strong>Kế hoạch giảng dạy</strong>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Grades" || ViewContext.RouteData.Values["page"]?.ToString() == "/ImportGrades" ? "active" : "")" asp-area="" asp-page="/Grades">
                            <strong>Bảng điểm tổng hợp</strong>
                        </a>
                    </li>
                </ul>

                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (!AdminAuth.IsPasswordConfigured())
                    {
                        <span class="badge bg-warning text-dark" style="font-size: 11px;">⚠️ Chưa đặt mật khẩu</span>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="badge bg-primary" style="font-size: 11px; font-weight: normal;">Quản trị viên</span>
                        <form method="post" asp-page="/Login" asp-page-handler="Logout" class="d-inline m-0 p-0">
                            <button type="submit" class="toolbar-btn text-danger border-0 bg-transparent" style="cursor: pointer;">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-secondary" style="font-size: 11px; font-weight: normal;">Khách (Chỉ xem)</span>
                        <a class="toolbar-btn" asp-area="" asp-page="/Login">Đăng nhập</a>
                    }
                </div>
            </nav>
        </header>

        <!-- Main Workspace View -->
        <main role="main" class="desktop-workspace">
            @RenderBody()
        </main>

        <!-- Classic Desktop StatusBar -->
        <footer class="desktop-statusbar">
            <div class="statusbar-cell">
                <span>Chế độ: @(User.Identity?.IsAuthenticated == true ? "Quản trị viên" : "Chỉ xem")</span>
            </div>
            <div class="statusbar-cell">
                <span>Phiên bản 1.0 (.NET 8)</span>
            </div>
            <div class="statusbar-cell">
                <span>Thực hiện: <a href="https://43soft.com" target="_blank" rel="noopener noreferrer" style="color: #0d6efd; text-decoration: none; font-weight: 600;">43Soft</a></span>
            </div>
            @if (!AdminAuth.IsPasswordConfigured())
            {
                <div class="statusbar-cell text-warning fw-bold">
                    <span>⚠️ Khóa ghi (Chưa đặt mật khẩu quản trị)</span>
                </div>
            }
            <div class="statusbar-cell ms-auto">
                <span>&copy; @DateTime.Now.Year Kế hoạch học tập</span>
            </div>
        </footer>
    </div>

    <!-- Hệ thống Toast Thả Xuống Toàn Cục -->
    <div id="toastDropdownContainer" class="toast-dropdown-container" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        var toastSuccess = TempData["SuccessMessage"]?.ToString() ?? ViewData["SuccessMessage"]?.ToString();
        var toastError = TempData["ErrorMessage"]?.ToString() ?? ViewData["ErrorMessage"]?.ToString();
    }
    @if (!string.IsNullOrEmpty(toastSuccess) || !string.IsNullOrEmpty(toastError))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                @if (!string.IsNullOrEmpty(toastSuccess))
                {
                    <text>if (typeof window.showToast === 'function') { window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastSuccess)), 'success'); }</text>
                }
                @if (!string.IsNullOrEmpty(toastError))
                {
                    <text>if (typeof window.showToast === 'function') { window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastError)), 'error'); }</text>
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
