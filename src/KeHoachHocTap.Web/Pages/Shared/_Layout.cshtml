@inject KeHoachHocTap.Web.Services.IAdminAuthService AdminAuth
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Kế hoạch học tập</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="desktop-app">
        <!-- Application Title Bar -->
        <header>
            <div class="desktop-titlebar">
                <div class="desktop-titlebar-title">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z"/>
                    </svg>
                    <span>HỆ THỐNG QUẢN LÝ KẾ HOẠCH HỌC TẬP VÀ GIẢNG DẠY</span>
                </div>
                <div class="desktop-titlebar-meta">
                    @if (!AdminAuth.IsPasswordConfigured())
                    {
                        <span class="badge bg-warning text-dark me-2">⚠️ Mật khẩu quản trị chưa đặt (Chế độ chỉ xem)</span>
                    }
                    <span>Phiên bản 1.0 (.NET 8)</span>
                </div>
            </div>

            <!-- Toolbar / Menubar -->
            <nav class="desktop-menubar">
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-area="" asp-page="/Index">
                            <strong>Môn học</strong>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Holidays" ? "active" : "")" asp-area="" asp-page="/Holidays">
                            <strong>Ngày nghỉ</strong>
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Import" ? "active" : "")" asp-area="" asp-page="/Import">
                                <strong>Nhập từ Excel</strong>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Export" ? "active" : "")" asp-area="" asp-page="/Export">
                            <strong>Biểu mẫu Word &amp; Xuất file</strong>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Templates" ? "active" : "")" asp-area="" asp-page="/Templates">
                            <strong>Quản lý Mẫu biểu</strong>
                        </a>
                    </li>
                </ul>

                <div class="ms-auto d-flex align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="badge bg-primary" style="font-size: 11px; font-weight: normal;">Quản trị viên</span>
                        <form method="post" asp-page="/Login" asp-page-handler="Logout" class="d-inline m-0 p-0">
                            <button type="submit" class="toolbar-btn text-danger border-0 bg-transparent" style="cursor: pointer;">Đăng xuất</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-secondary" style="font-size: 11px; font-weight: normal;">Khách (Chỉ xem)</span>
                        <a class="toolbar-btn" asp-area="" asp-page="/Login">Đăng nhập</a>
                    }
                </div>
            </nav>
        </header>

        <!-- Main Workspace View -->
        <main role="main" class="desktop-workspace">
            @RenderBody()
        </main>

        <!-- Classic Desktop StatusBar -->
        <footer class="desktop-statusbar">
            <div class="statusbar-cell">
                <span class="status-dot"></span>
                <span id="statusMessage">@(ViewData["StatusMessage"] ?? "Sẵn sàng")</span>
            </div>
            <div class="statusbar-cell">
                <span>Cơ sở dữ liệu: SQL Server</span>
            </div>
            <div class="statusbar-cell">
                <span>Tổng môn học: @(ViewData["TotalSubjects"] ?? "—")</span>
            </div>
            <div class="statusbar-cell">
                <span>Chế độ: @(User.Identity?.IsAuthenticated == true ? "Quản trị viên" : "Chỉ xem")</span>
            </div>
            @if (!AdminAuth.IsPasswordConfigured())
            {
                <div class="statusbar-cell text-warning fw-bold">
                    <span>⚠️ Khóa ghi (Chưa đặt mật khẩu quản trị)</span>
                </div>
            }
            <div class="statusbar-cell">
                <span>&copy; @DateTime.Now.Year Kế hoạch học tập</span>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
