@page
@model ErrorModel
@{
    ViewData["Title"] = "Thông báo sự cố";
}

<div class="desktop-panel">
    <div class="desktop-panel-header">
        <div class="d-flex align-items-center gap-2 text-danger">
            <span>THÔNG BÁO SỰ CỐ HỆ THỐNG</span>
        </div>
    </div>

    <div class="desktop-panel-body p-4">
        <div class="alert alert-danger py-3 px-3 border-1 mb-3" style="border-color: #ef4444; background-color: #fef2f2; color: #b91c1c;">
            <h6 class="fw-bold mb-2">✕ @(Model.IsDatabaseError ? "Không kết nối được cơ sở dữ liệu" : "Đã xảy ra lỗi trong quá trình xử lý")</h6>
            <p class="mb-0 small">@Model.ErrorMessage</p>
        </div>

        @if (Model.ShowRequestId)
        {
            <div class="text-secondary small mb-3">
                <span>Mã yêu cầu (Request ID): <code>@Model.RequestId</code></span>
            </div>
        }

        <div class="d-flex gap-2">
            <a asp-page="/Index" class="btn btn-primary btn-sm fw-bold px-3">
                Kế hoạch giảng dạy
            </a>
            <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="window.location.reload();">
                Tải lại trang
            </button>
        </div>
    </div>
</div>
