@page
@model HolidaysModel
@{
    ViewData["Title"] = "Quản lý Ngày nghỉ & Khai giảng";
}

<div class="desktop-panel">
    <!-- Panel Header -->
    <div class="desktop-panel-header">
        <div class="d-flex align-items-center gap-2">
            <span>NGÀY NGHỈ VÀ KHAI GIẢNG</span>
        </div>
        <div>
            <span class="text-secondary small">Tổng cộng: <strong>@Model.Holidays.Count</strong> khoảng thời gian</span>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="desktop-toolbar">
        @if (Model.IsAdmin)
        {
            <button type="button" class="toolbar-btn btn-primary" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
                Thêm ngày nghỉ
            </button>
            <span class="toolbar-separator"></span>
        }
        <a asp-page="/Index" class="toolbar-btn">
            Kế hoạch giảng dạy
        </a>
        <a asp-page="/Holidays" class="toolbar-btn">
            Làm mới
        </a>
        <span class="toolbar-separator"></span>
        @if (Model.IsAdmin)
        {
            <form method="post" asp-page-handler="SetFirstSessionHalf" class="d-inline-flex align-items-center gap-1 my-0 py-0" title="Chọn buổi bắt đầu học môn 1 sau khai giảng">
                <span class="small fw-bold text-secondary text-nowrap">Môn 1 bắt đầu:</span>
                <select name="firstSessionHalf" class="desktop-input form-select-sm" style="height: 26px; padding: 1px 6px; font-size: 12px; font-weight: bold; background-color: #fff;" onchange="this.form.submit()">
                    <option value="S" selected="@(Model.FirstSessionHalf == "S")">Buổi Sáng (S)</option>
                    <option value="C" selected="@(Model.FirstSessionHalf == "C")">Buổi Chiều (C)</option>
                </select>
            </form>
        }
        else
        {
            <div class="d-inline-flex align-items-center gap-1">
                <span class="small text-secondary">Môn 1 bắt đầu:</span>
                <span class="badge @(Model.FirstSessionHalf == "C" ? "bg-warning text-dark" : "bg-primary")" style="font-size: 11px;">
                    @(Model.FirstSessionHalf == "C" ? "Buổi Chiều (C)" : "Buổi Sáng (S)")
                </span>
            </div>
        }

        <!-- Nút chuyển chế độ xem di động -->
        <div class="ms-auto d-flex align-items-center gap-1 view-mode-toggle">
            <button type="button" class="toolbar-btn btn-primary btn-sm" id="btnHolidaysCards" title="Xem dạng thẻ (Phù hợp di động)">Dạng thẻ</button>
            <button type="button" class="toolbar-btn btn-sm" id="btnHolidaysTable" title="Xem dạng bảng đầy đủ">Dạng bảng</button>
        </div>
    </div>

    <!-- Panel Body -->
    <div class="desktop-panel-body p-2">
        <!-- Thông báo hệ thống qua Toast Thả Xuống -->
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof window.showToast === 'function') {
                        window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SuccessMessage)), 'success');
                    }
                });
            </script>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof window.showToast === 'function') {
                        window.showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ErrorMessage)), 'error');
                    }
                });
            </script>
        }

        @if (Model.Holidays.Count == 0)
        {
            <div class="text-center py-5 bg-white border">
                <svg width="48" height="48" fill="#9ca3af" viewBox="0 0 16 16" class="mb-3">
                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z"/>
                </svg>
                <h6 class="fw-bold text-dark">Chưa có thông tin ngày nghỉ hoặc khai giảng</h6>
                <p class="text-muted small mb-0">Vui lòng thêm ít nhất một ngày khai giảng cho khóa học.</p>
            </div>
        }
        else
        {
            <!-- Mobile Cards View cho Ngày nghỉ -->
            <div class="mobile-cards-container active-view" id="holidaysCardsContainer">
                @for (int i = 0; i < Model.Holidays.Count; i++)
                {
                    var h = Model.Holidays[i];
                    var dayCount = h.To.DayNumber - h.From.DayNumber + 1;
                    <div class="mobile-card @(h.IsOpeningDay ? "border-primary" : "")">
                        <div class="mobile-card-header">
                            <div class="mobile-card-title">
                                <span class="badge @(h.IsOpeningDay ? "bg-primary" : "bg-secondary")">#@(i + 1)</span>
                                <span>@h.Name</span>
                            </div>
                            <div>
                                @if (h.IsOpeningDay)
                                {
                                    <span class="badge bg-success">✓ Khai giảng</span>
                                    <span class="badge bg-light text-dark border ms-1" title="Buổi bắt đầu học môn 1">Môn 1: @(Model.FirstSessionHalf == "C" ? "Chiều (C)" : "Sáng (S)")</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border">@dayCount ngày</span>
                                }
                            </div>
                        </div>
                        <div class="mobile-card-body">
                            <div class="mobile-kv-grid">
                                <div class="mobile-kv-item">
                                    <span class="mobile-kv-label">Từ ngày</span>
                                    <span class="mobile-kv-value">@h.From.ToString("d/M/yyyy")</span>
                                </div>
                                <div class="mobile-kv-item">
                                    <span class="mobile-kv-label">Đến ngày</span>
                                    <span class="mobile-kv-value">@h.To.ToString("d/M/yyyy")</span>
                                </div>
                                <div class="mobile-kv-item">
                                    <span class="mobile-kv-label">Tổng số ngày nghỉ</span>
                                    <span class="mobile-kv-value text-primary fw-bold">@dayCount ngày</span>
                                </div>
                                <div class="mobile-kv-item">
                                    <span class="mobile-kv-label">Tính chất</span>
                                    <span class="mobile-kv-value">@(h.IsOpeningDay ? "Ngày Khai giảng" : "Nghỉ lễ / Tết")</span>
                                </div>
                            </div>
                        </div>
                        @if (Model.IsAdmin)
                        {
                            <div class="mobile-card-footer">
                                <span class="small text-muted">ID: #@h.Id</span>
                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="card-action-btn btn-edit-holiday"
                                            data-id="@h.Id"
                                            data-name="@h.Name"
                                            data-from="@h.From.ToString("yyyy-MM-dd")"
                                            data-to="@h.To.ToString("yyyy-MM-dd")"
                                            data-isopening="@(h.IsOpeningDay ? "true" : "false")">
                                        Sửa
                                    </button>
                                    @if (!h.IsOpeningDay)
                                    {
                                        <button type="button" class="card-action-btn text-danger btn-delete-holiday"
                                                data-id="@h.Id"
                                                data-name="@h.Name">
                                            Xóa
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="desktop-datagrid-container hidden-mobile" id="holidaysTableContainer">
                <table class="desktop-grid table-sm table-bordered">
                    <thead>
                        <tr>
                            <th style="width: 45px;" class="text-center sticky-col-stt">STT</th>
                            <th class="sticky-col-name">Tên ngày nghỉ / Sự kiện</th>
                            <th style="width: 130px;" class="text-center">Từ ngày</th>
                            <th style="width: 130px;" class="text-center">Đến ngày</th>
                            <th style="width: 90px;" class="text-center">Số ngày</th>
                            <th style="width: 130px;" class="text-center">Khai giảng</th>
                            @if (Model.IsAdmin)
                            {
                                <th style="width: 100px;" class="text-center">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Holidays.Count; i++)
                        {
                            var h = Model.Holidays[i];
                            var dayCount = h.To.DayNumber - h.From.DayNumber + 1;
                            <tr class="@(h.IsOpeningDay ? "bg-light" : "")">
                                <td class="text-center fw-bold sticky-col-stt">@(i + 1)</td>
                                <td class="fw-bold sticky-col-name @(h.IsOpeningDay ? "text-primary" : "")">
                                    @h.Name
                                </td>
                                <td class="text-center">@h.From.ToString("d/M/yyyy")</td>
                                <td class="text-center">@h.To.ToString("d/M/yyyy")</td>
                                <td class="text-center">@dayCount ngày</td>
                                <td class="text-center">
                                    @if (h.IsOpeningDay)
                                    {
                                        <span class="badge bg-success" style="font-size: 11px;">✓ Khai giảng</span>
                                        <span class="badge bg-light text-dark border ms-1" style="font-size: 10px;" title="Buổi bắt đầu học môn 1">Môn 1: @(Model.FirstSessionHalf == "C" ? "Chiều (C)" : "Sáng (S)")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                @if (Model.IsAdmin)
                                {
                                    <td class="text-center text-nowrap">
                                        <div class="d-inline-flex gap-1 align-items-center">
                                            <!-- Edit -->
                                            <button type="button" class="grid-btn btn-edit-holiday" title="Sửa ngày nghỉ"
                                                    data-id="@h.Id"
                                                    data-name="@h.Name"
                                                    data-from="@h.From.ToString("yyyy-MM-dd")"
                                                    data-to="@h.To.ToString("yyyy-MM-dd")"
                                                    data-isopening="@(h.IsOpeningDay ? "true" : "false")">
                                                ✎
                                            </button>

                                            <!-- Delete -->
                                            @if (!h.IsOpeningDay)
                                            {
                                                <button type="button" class="grid-btn text-danger btn-delete-holiday" title="Xóa ngày nghỉ"
                                                        data-id="@h.Id"
                                                        data-name="@h.Name">
                                                    ✕
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="grid-btn" disabled title="Không thể xóa ngày khai giảng duy nhất">
                                                    ✕
                                                </button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ========================================================================= -->
<!-- Modal Thêm Ngày nghỉ (Chỉ Admin) -->
<!-- ========================================================================= -->
@if (Model.IsAdmin)
{
    <div class="modal fade" id="addHolidayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="AddHoliday">
                    <div class="modal-header desktop-titlebar py-2 text-white">
                        <h6 class="modal-title fw-bold">THÊM NGÀY NGHỈ / SỰ KIỆN</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-3">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên ngày nghỉ / Sự kiện <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="desktop-input w-100" placeholder="Ví dụ: Tết Nguyên Đán, Nghỉ Lễ 30/4..." required maxlength="200" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Từ ngày <span class="text-danger">*</span></label>
                                <input type="date" id="addFromDate" name="From" class="desktop-input w-100" required />
                            </div>
                            <div class="col-md-6 mb-3" id="addToDateGroup">
                                <label class="form-label fw-bold">Đến ngày <span class="text-danger">*</span></label>
                                <input type="date" id="addToDate" name="To" class="desktop-input w-100" required />
                            </div>
                        </div>
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="checkbox" name="IsOpeningDay" value="true" id="addIsOpeningDay">
                            <label class="form-check-label fw-bold text-primary" for="addIsOpeningDay">
                                Đặt làm Ngày Khai Giảng khóa học
                            </label>
                            <div class="text-muted small">Nếu chọn, ngày khai giảng cũ sẽ tự động chuyển thành ngày nghỉ thông thường. Ngày khai giảng có thể diễn ra trong 1 hoặc nhiều ngày (Từ ngày → Đến ngày).</div>
                        </div>
                    </div>
                    <div class="modal-footer p-2 bg-light">
                        <button type="button" class="toolbar-btn" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="toolbar-btn btn-primary px-3">Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Sửa Ngày nghỉ (Chỉ Admin) -->
    <div class="modal fade" id="editHolidayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdateHoliday">
                    <input type="hidden" id="editHolidayId" name="Id" />
                    <div class="modal-header desktop-titlebar py-2 text-white">
                        <h6 class="modal-title fw-bold">CHỈNH SỬA NGÀY NGHỈ</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-3">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên ngày nghỉ / Sự kiện <span class="text-danger">*</span></label>
                            <input type="text" id="editHolidayName" name="Name" class="desktop-input w-100" required maxlength="200" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Từ ngày <span class="text-danger">*</span></label>
                                <input type="date" id="editFromDate" name="From" class="desktop-input w-100" required />
                            </div>
                            <div class="col-md-6 mb-3" id="editToDateGroup">
                                <label class="form-label fw-bold">Đến ngày <span class="text-danger">*</span></label>
                                <input type="date" id="editToDate" name="To" class="desktop-input w-100" required />
                            </div>
                        </div>
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="checkbox" name="IsOpeningDay" value="true" id="editIsOpeningDay">
                            <label class="form-check-label fw-bold text-primary" for="editIsOpeningDay">
                                Đặt làm Ngày Khai Giảng khóa học
                            </label>
                            <div class="text-muted small">Hệ thống luôn đảm bảo có đúng một sự kiện khai giảng duy nhất (có thể kéo dài 1 hoặc nhiều ngày).</div>
                        </div>
                    </div>
                    <div class="modal-footer p-2 bg-light">
                        <button type="button" class="toolbar-btn" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="toolbar-btn btn-primary px-3">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Xóa Ngày nghỉ (Chỉ Admin) -->
    <div class="modal fade" id="deleteHolidayModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <form method="post" asp-page-handler="DeleteHoliday">
                    <input type="hidden" id="deleteHolidayId" name="id" />
                    <div class="modal-header bg-danger text-white py-2">
                        <h6 class="modal-title fw-bold">XÁC NHẬN XÓA</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-3 text-center">
                        <p class="mb-1">Bạn có chắc chắn muốn xóa ngày nghỉ:</p>
                        <p class="fw-bold text-danger mb-2" id="deleteHolidayName"></p>
                        <span class="text-muted small">Thời khóa biểu các môn học sẽ được tự động tính toán lại.</span>
                    </div>
                    <div class="modal-footer p-2 bg-light justify-content-center">
                        <button type="button" class="toolbar-btn" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="toolbar-btn btn-danger px-3">Xóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-edit-holiday').on('click', function () {
                var btn = $(this);
                $('#editHolidayId').val(btn.data('id'));
                $('#editHolidayName').val(btn.data('name'));
                $('#editFromDate').val(btn.data('from'));
                $('#editToDate').val(btn.data('to'));
                var isOpening = btn.data('isopening') === true || btn.data('isopening') === 'true';
                $('#editIsOpeningDay').prop('checked', isOpening);

                var modal = new bootstrap.Modal(document.getElementById('editHolidayModal'));
                modal.show();
            });

            $('.btn-delete-holiday').on('click', function () {
                var btn = $(this);
                $('#deleteHolidayId').val(btn.data('id'));
                $('#deleteHolidayName').text(btn.data('name'));

                var modal = new bootstrap.Modal(document.getElementById('deleteHolidayModal'));
                modal.show();
            });

            // Chuyển đổi qua lại giữa Thẻ & Bảng trên thiết bị di động
            $('#btnHolidaysCards').on('click', function () {
                $('#holidaysCardsContainer').addClass('active-view');
                $('#holidaysTableContainer').addClass('hidden-mobile');
                $('#btnHolidaysCards').addClass('btn-primary');
                $('#btnHolidaysTable').removeClass('btn-primary');
                localStorage.setItem('holidays_view_mode', 'cards');
            });

            $('#btnHolidaysTable').on('click', function () {
                $('#holidaysCardsContainer').removeClass('active-view');
                $('#holidaysTableContainer').removeClass('hidden-mobile');
                $('#btnHolidaysTable').addClass('btn-primary');
                $('#btnHolidaysCards').removeClass('btn-primary');
                localStorage.setItem('holidays_view_mode', 'table');
            });

            var savedMode = localStorage.getItem('holidays_view_mode');
            if (savedMode === 'table') {
                $('#btnHolidaysTable').trigger('click');
            }
        });
    </script>
}
