@page
@model ExportModel
@{
    ViewData["Title"] = "Xuất biểu mẫu";
}

<div class="desktop-panel">
    <!-- Panel Header -->
    <div class="desktop-panel-header">
        <div class="d-flex align-items-center gap-2">
            <span>XUẤT BIỂU MẪU KẾ HOẠCH GIẢNG DẠY</span>
        </div>
        <div>
            <span class="text-secondary small">Định dạng: Word (.docx), In / PDF (.pdf)</span>
        </div>
    </div>

    <!-- Toolbar -->
    <div class="desktop-toolbar">
        <a asp-page="/Index" class="toolbar-btn">
            Kế hoạch giảng dạy
        </a>
        <a asp-page="/Templates" class="toolbar-btn">
            Mẫu biểu
        </a>
    </div>

    <!-- Panel Body -->
    <div class="desktop-panel-body p-3">
        <!-- Cảnh báo thời gian nhiệm vụ đặc biệt rơi vào ngày nghỉ hoặc cuối tuần (SPEC mục 7.1) -->
        @if (Model.ExtraTaskWarnings.Count > 0)
        {
            <div class="alert alert-warning py-2 px-3 small border-1 mb-3" style="border-color: #f59e0b; background-color: #fffbeb; color: #92400e;">
                <div class="fw-bold mb-1">Lưu ý về lịch nhiệm vụ đặc biệt:</div>
                <ul class="mb-0 ps-3">
                    @foreach (var warning in Model.ExtraTaskWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <!-- Cảnh báo xếp lịch chung nếu có -->
        @if (Model.Schedule?.Warnings.Count > 0)
        {
            <div class="alert alert-warning py-2 px-3 small border-1 mb-3" style="border-color: #f59e0b; background-color: #fffbeb; color: #92400e;">
                <div class="fw-bold mb-1">Cảnh báo kế hoạch học tập:</div>
                <ul class="mb-0 ps-3">
                    @foreach (var w in Model.Schedule.Warnings)
                    {
                        <li>@w</li>
                    }
                </ul>
            </div>
        }

        <div class="row g-3">
            <!-- Danh sách bộ xuất file -->
            <div class="col-lg-8">
                <div class="desktop-card p-3 bg-white border" style="border-color: #dee2e6;">
                    <h6 class="fw-bold mb-3" style="color: #1d4ed8; font-size: 13px; text-transform: uppercase;">
                        Danh sách định dạng biểu mẫu sẵn sàng xuất
                    </h6>

                    <div class="list-group">
                        <!-- 1. Định dạng Word (.docx) -->
                        @foreach (var exporter in Model.Exporters)
                        {
                            <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 p-3 border mb-3" style="border-color: #dee2e6; background-color: #f8fafc;">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-primary px-2 py-1" style="font-size: 11px;">@exporter.Extension.ToUpperInvariant()</span>
                                        <strong style="font-size: 14px; color: #0f172a;">@exporter.DisplayName</strong>
                                    </div>
                                    <div class="text-secondary small mb-1">
                                        <span>Mẫu áp dụng: 
                                            @if (Model.CurrentTemplate?.IsCustom == true)
                                            {
                                                <span class="badge bg-success" style="font-size: 10px;">Tùy biến của trường</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary" style="font-size: 10px;">Mẫu gốc chuẩn</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="text-muted small">
                                        Điền đầy đủ các môn học theo lịch tính toán, giữ nguyên định dạng và cấu trúc bảng Word.
                                    </div>
                                </div>
                                <div class="text-nowrap">
                                    <a asp-page="/Export" asp-page-handler="Download" asp-route-id="@exporter.Id" class="btn btn-primary btn-sm fw-bold btn-action-loading" style="background-color: #1d4ed8; border-color: #1d4ed8; width: 120px; height: 34px; display: inline-flex; align-items: center; justify-content: center;">
                                        Xuất Word
                                    </a>
                                </div>
                            </div>
                        }

                        <!-- 2. Định dạng Bản in & Lưu PDF (.pdf) -->
                        <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 p-3 border mb-2" style="border-color: #dee2e6; background-color: #f8fafc;">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-danger px-2 py-1" style="width: 55px; text-align: center; font-size: 11px;">PDF</span>
                                    <strong style="font-size: 14px; color: #0f172a;">Bản in PDF (.pdf)</strong>
                                </div>
                                <div class="text-muted small">
                                    Bản in A4 ngang chuẩn công văn, căn lề in ấn sắc nét, tích hợp chữ ký 3 bên và lưu file PDF.
                                </div>
                            </div>
                            <div class="text-nowrap">
                                <a asp-page="/PrintPlan" target="_blank" class="btn btn-danger btn-sm fw-bold" style="width: 120px; height: 34px; display: inline-flex; align-items: center; justify-content: center;">
                                    Xuất PDF
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tóm tắt thông tin kế hoạch và nhiệm vụ -->
            <div class="col-lg-4">
                <div class="desktop-card p-3 bg-white border" style="border-color: #dee2e6;">
                    <h6 class="fw-bold mb-3" style="color: #334155; font-size: 13px; text-transform: uppercase;">
                        Thông số xuất file kế hoạch
                    </h6>

                    <table class="table table-sm table-bordered small mb-3">
                        <tbody>
                            <tr>
                                <td class="bg-light text-secondary" style="width: 45%;">Ngày khai giảng</td>
                                <td class="fw-bold text-primary">
                                    @(Model.Schedule != null ? $"S {Model.Schedule.OpeningDay.Day}/{Model.Schedule.OpeningDay.Month}/{Model.Schedule.OpeningDay.Year}" : "—")
                                </td>
                            </tr>
                            <tr>
                                <td class="bg-light text-secondary">Tổng số môn học</td>
                                <td class="fw-bold">@(Model.Schedule?.Items.Count ?? 0) môn</td>
                            </tr>
                            <tr>
                                <td class="bg-light text-secondary">Tự học / môn</td>
                                <td>@(Model.Options?.SelfStudyPeriods ?? 10) tiết</td>
                            </tr>
                            <tr>
                                <td class="bg-light text-secondary">Ôn thi / môn</td>
                                <td>@(Model.Options?.ExamPeriods ?? 5) tiết (1 buổi)</td>
                            </tr>
                            <tr>
                                <td class="bg-light text-secondary">Thi tốt nghiệp</td>
                                <td>
                                    <strong>@(Model.Options?.Graduation.Name)</strong> (@(Model.Options?.Graduation.Periods) tiết)<br />
                                    <span class="text-secondary">@Model.Options?.Graduation.Start → @Model.Options?.Graduation.End</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="bg-light text-secondary">Bế giảng</td>
                                <td>
                                    <strong>@(Model.Options?.Closing.Name)</strong> (@(Model.Options?.Closing.Periods) tiết)<br />
                                    <span class="text-secondary">@Model.Options?.Closing.Start</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-grid gap-2">
                        <a asp-page="/Templates" class="btn btn-outline-secondary btn-sm text-start">
                            Cấu hình &amp; Mẫu biểu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
